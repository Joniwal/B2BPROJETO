# ==========================================================================
# ORIGEM DOS DADOS — ARQUIVO EXCEL LOCAL
# ==========================================================================
# Caminho completo do arquivo Excel usado pela aplicação.
# Windows: use o caminho completo, por exemplo:
# EXCEL_PATH=C:\Users\PEGGY\Desktop\PROJETO\REDE_B2B.xlsx
EXCEL_PATH=C:\Users\PEGGY\Desktop\PROJETO\REDE_B2B.xlsx

# Nome da planilha (aba) dentro do arquivo Excel que contém os dados.
EXCEL_SHEET_NAME=TbRelatorio

# ==========================================================================
# FLASK
# ==========================================================================
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=troque-esta-chave-em-producao
PORT=5000
